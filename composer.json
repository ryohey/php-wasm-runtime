{
    "name": "php-wasm/php-wasm",
    "description": "Pure PHP WebAssembly runtime – monorepo",
    "type": "project",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {"type": "path", "url": "packages/runtime"},
        {"type": "path", "url": "packages/wasi"},
        {"type": "path", "url": "packages/cli"}
    ],
    "require": {
        "php": ">=8.1",
        "php-wasm/runtime": "*",
        "php-wasm/wasi": "*",
        "php-wasm/cli": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "WasmRuntime\\Tests\\": "packages/runtime/tests/",
            "WasmRuntime\\Tests\\Wasi\\": "packages/wasi/tests/"
        }
    }
}
