{
    "name": "php-wasm/runtime",
    "description": "Pure PHP WebAssembly (WAT/WAST) runtime – core interpreter",
    "type": "library",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "WasmRuntime\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WasmRuntime\\Tests\\": "tests/"
        }
    }
}
