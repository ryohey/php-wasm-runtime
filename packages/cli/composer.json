{
    "name": "php-wasm/cli",
    "description": "Command-line interface for php-wasm/runtime with optional WASI support",
    "type": "library",
    "require": {
        "php": ">=8.1",
        "php-wasm/runtime": "*",
        "php-wasm/wasi": "*"
    },
    "autoload": {
        "psr-4": {
            "WasmRuntime\\": "src/"
        }
    },
    "bin": [
        "bin/wasm"
    ]
}
